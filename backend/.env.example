ENV=development
DEMO_MODE=true
SECRET_KEY=change-this-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=sqlite:///./incidentzero.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true only if you're running a real Elastic cluster (see docker-compose.yml,
# `elastic` profile) and have run scripts/ingest_to_elastic.py
ELASTIC_ENABLED=false
ELASTIC_URL=http://localhost:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_INDEX_PREFIX=incidentzero

# Set to true only if you have Ollama running locally with a Gemma model pulled:
#   ollama pull gemma2:9b
#   ollama serve
GEMMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma2:9b
GEMMA_TEMPERATURE=0.2
GEMMA_TIMEOUT_SECONDS=60

# ---- MCP ----
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
